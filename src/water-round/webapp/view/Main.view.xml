<mvc:View
    controllerName="oakhaven.waterround.controller.Main"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    core:require="{
        formatMessage: 'sap/base/strings/formatMessage',
        DateTime: 'sap/ui/model/type/DateTime',
        DateTimeOffset: 'sap/ui/model/odata/type/DateTimeOffset'
    }"
    displayBlock="true"
    height="100%">
    <f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle id="pageTitle">
                <f:heading>
                    <Title id="pageTitleText" text="{i18n>appTitle}" level="H1" wrapping="true" />
                </f:heading>
                <f:snappedContent>
                    <Label id="lastUpdatedSnapped" text="{ parts: ['i18n>lastUpdated', { path: 'view>/lastUpdated', type: 'DateTime', formatOptions: { style: 'medium' } }], formatter: 'formatMessage' }" />
                </f:snappedContent>
                <f:expandedContent>
                    <Label id="lastUpdated" text="{ parts: ['i18n>lastUpdated', { path: 'view>/lastUpdated', type: 'DateTime', formatOptions: { style: 'medium' } }], formatter: 'formatMessage' }" />
                </f:expandedContent>
                <f:actions>
                    <Button id="refreshButton" icon="sap-icon://ti/refresh" tooltip="{i18n>refreshTooltip}" press=".onRefresh" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <IconTabBar id="tabs" expandable="false" headerBackgroundDesign="Transparent" stretchContentHeight="false">
                <items>
                    <!-- ============ Morning: phone, gloves — big, simple, no table ============ -->
                    <IconTabFilter id="tabMorning" key="morning" icon="sap-icon://ti/sun" text="{i18n>tabMorning}">
                        <List
                            id="roundList"
                            noDataText="{i18n>noData}"
                            updateFinished=".onListUpdateFinished"
                            items="{ path: '/MorningRound', sorter: { path: 'rank', group: '.getSection' }, templateShareable: false }">
                            <CustomListItem id="roundItem">
                                <HBox id="roundItemBox" alignItems="Start" class="wrItem">
                                    <Title id="roundRank" text="{rank}" level="H2" class="wrRank" />
                                    <VBox id="roundItemText">
                                        <ObjectStatus
                                            id="roundStatus"
                                            text="{ path: 'status', formatter: '.statusText' }"
                                            icon="{ path: 'status', formatter: '.statusIcon' }"
                                            state="{ path: 'status', formatter: '.statusState' }"
                                            inverted="{today}"
                                            class="sapMObjectStatusLarge sapUiTinyMarginBottom" />
                                        <Title id="roundPipe" text="{pipeID}" level="H3" wrapping="true" />
                                        <Text id="roundRoute" text="{location}" class="wrRoute" />
                                        <Text
                                            id="roundWhy"
                                            class="wrWhy sapUiTinyMarginTop"
                                            text="{ parts: ['status', 'reasonCode', 'flowPercent',
                                                            { path: 'sensorPressure', targetType: 'any' }, 'readingAgeMinutes',
                                                            { path: 'sensorFlow', targetType: 'any' }, { path: 'pipeFlow', targetType: 'any' },
                                                            { path: 'pipePressure', targetType: 'any' }, { path: 'nominalFlow', targetType: 'any' },
                                                            'impactLandmark', 'impactKind', 'families'],
                                                    formatter: '.formatWhy' }" />
                                    </VBox>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </IconTabFilter>

                    <!-- ============ Evening: laptop — all the details ============ -->
                    <IconTabFilter id="tabEvening" key="evening" icon="sap-icon://ti/moon" text="{i18n>tabEvening}">
                        <Table
                            id="detailsTable"
                            noDataText="{i18n>noData}"
                            items="{ path: '/MorningRound', sorter: { path: 'rank' }, templateShareable: false }">
                            <columns>
                                <Column id="colRank" width="3rem"><Text id="colRankHdr" text="{i18n>colRank}" /></Column>
                                <Column id="colPipe"><Text id="colPipeHdr" text="{i18n>colPipe}" /></Column>
                                <Column id="colStatus"><Text id="colStatusHdr" text="{i18n>colStatus}" /></Column>
                                <Column id="colFlow" hAlign="End"><Text id="colFlowHdr" text="{i18n>colFlow}" /></Column>
                                <Column id="colNominal" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text id="colNominalHdr" text="{i18n>colNominal}" /></Column>
                                <Column id="colPipeFlow" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text id="colPipeFlowHdr" text="{i18n>colPipeFlow}" /></Column>
                                <Column id="colPressure" hAlign="End"><Text id="colPressureHdr" text="{i18n>colPressure}" /></Column>
                                <Column id="colAge" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text id="colAgeHdr" text="{i18n>colReadingAge}" /></Column>
                                <Column id="colAffected" minScreenWidth="Desktop" demandPopin="true"><Text id="colAffectedHdr" text="{i18n>colAffected}" /></Column>
                                <Column id="colMaintenance" hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text id="colMaintenanceHdr" text="{i18n>colMaintenance}" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem id="detailsRow">
                                    <cells>
                                        <Text id="detailsRank" text="{rank}" />
                                        <ObjectIdentifier id="detailsPipe" title="{pipeID}" text="{location}" />
                                        <ObjectStatus
                                            id="detailsStatus"
                                            text="{ path: 'status', formatter: '.statusText' }"
                                            icon="{ path: 'status', formatter: '.statusIcon' }"
                                            state="{ path: 'status', formatter: '.statusState' }" />
                                        <ObjectNumber id="detailsFlow" number="{sensorFlow}" unit="{i18n>unitFlow}" />
                                        <ObjectNumber id="detailsNominal" number="{nominalFlow}" unit="{i18n>unitFlow}" />
                                        <ObjectNumber id="detailsPipeFlow" number="{pipeFlow}" unit="{i18n>unitFlow}" />
                                        <ObjectNumber id="detailsPressure" number="{sensorPressure}" unit="{i18n>unitPressure}" />
                                        <ObjectNumber id="detailsAge" number="{readingAgeMinutes}" unit="{i18n>unitMinutes}" />
                                        <Text id="detailsAffected" text="{affectedLandmarks}" />
                                        <ObjectNumber id="detailsMaintenance" number="{daysSinceMaintenance}" unit="{i18n>unitDays}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>

                        <Title id="repairsTitle" text="{i18n>repairsTitle}" level="H2" class="sapUiMediumMarginTop sapUiSmallMarginBottom" />
                        <Table
                            id="repairsTable"
                            noDataText="{i18n>noData}"
                            items="{ path: '/Repairs', sorter: [{ path: 'pipe/pipeID', group: true }, { path: 'repairDate', descending: true }], templateShareable: false }">
                            <columns>
                                <Column id="repairDateCol"><Text id="repairDateHdr" text="{i18n>repairDate}" /></Column>
                                <Column id="repairIssueCol"><Text id="repairIssueHdr" text="{i18n>repairIssue}" /></Column>
                                <Column id="repairByCol" minScreenWidth="Tablet" demandPopin="true"><Text id="repairByHdr" text="{i18n>repairBy}" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem id="repairRow">
                                    <cells>
                                        <Text id="repairDateCell" text="{ path: 'repairDate', type: 'DateTimeOffset', formatOptions: { style: 'medium' } }" />
                                        <Text id="repairIssueCell" text="{issue}" />
                                        <Text id="repairByCell" text="{repairedBy}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </f:content>
    </f:DynamicPage>
</mvc:View>
