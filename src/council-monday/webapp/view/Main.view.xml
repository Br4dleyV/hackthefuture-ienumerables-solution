<mvc:View
    controllerName="oakhaven.council.controller.Main"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    core:require="{
        formatMessage: 'sap/base/strings/formatMessage',
        DateTime: 'sap/ui/model/type/DateTime',
        DateTimeOffset: 'sap/ui/model/odata/type/DateTimeOffset'
    }"
    displayBlock="true"
    height="100%">
    <f:DynamicPage id="page" toggleHeaderOnTitleClick="false" class="cmPrintable">
        <f:title>
            <f:DynamicPageTitle id="pageTitle">
                <f:heading>
                    <Title id="pageTitleText" text="{i18n>appTitle}" level="H1" wrapping="true" />
                </f:heading>
                <f:expandedContent>
                    <VBox id="pageSubtitleBox">
                        <Label id="pageSubtitle" text="{i18n>pageSubtitle}" wrapping="true" />
                        <Label id="printedOn" text="{ parts: ['i18n>printedOn', { path: 'view>/loadedAt', type: 'DateTime', formatOptions: { style: 'full' } }], formatter: 'formatMessage' }" />
                    </VBox>
                </f:expandedContent>
                <f:actions>
                    <Button id="printButton" type="Emphasized" icon="sap-icon://ti/printer" text="{i18n>printButton}" press=".onPrint" class="cmNoPrint" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox id="content">
                <!-- ============ 0. Rowan: "the big picture first" — one line about the 500 crowns ============ -->
                <List id="budgetList" showNoData="false" class="sapUiSmallMarginBottom"
                    items="{ path: '/Budget', templateShareable: false }">
                    <CustomListItem id="budgetItem">
                        <VBox id="budgetBox" class="cmItem">
                            <Title id="budgetLine" level="H2" wrapping="true"
                                text="{ parts: ['i18n>budgetLine', 'spend', 'total', 'left'], formatter: 'formatMessage' }" />
                            <Text id="comparedWith" visible="{= !!${comparedWith} }"
                                text="{ parts: ['i18n>comparedWith', { path: 'comparedWith', type: 'DateTimeOffset', formatOptions: { style: 'long' } }], formatter: 'formatMessage' }" />
                            <Text id="firstPage" visible="{= !${comparedWith} }" text="{i18n>firstPage}" />
                        </VBox>
                    </CustomListItem>
                </List>

                <!-- ============ 1. Rowan: "where the crowns should go, and why" ============ -->
                <Title id="actionsTitle" text="{i18n>actionsTitle}" level="H2" class="sapUiSmallMarginBottom" />
                <List id="actionsList" noDataText="{i18n>noData}" updateFinished=".onLoaded"
                    items="{ path: '/Actions', sorter: { path: 'rank' }, templateShareable: false }">
                    <CustomListItem id="actionItem">
                        <HBox id="actionBox" alignItems="Start" class="cmItem">
                            <Title id="actionRank" text="{rank}" level="H3" class="cmRank" />
                            <VBox id="actionText">
                                <HBox id="actionHead" alignItems="Center" wrap="Wrap">
                                    <ObjectStatus id="actionLevel" class="sapUiSmallMarginEnd"
                                        text="{ path: 'level', formatter: '.levelText' }"
                                        icon="{ path: 'level', formatter: '.levelIcon' }"
                                        state="{ path: 'level', formatter: '.levelState' }" />
                                    <Text id="actionCost" class="cmCost" text="{ path: 'cost', formatter: '.costText' }" />
                                </HBox>
                                <Text id="actionWhy" class="cmWhy"
                                    text="{ parts: ['kind', 'level', 'target', 'fromPlace', 'toPlace', 'areas', 'families', { path: 'days', targetType: 'any' }, 'leadDays'], formatter: '.actionWhy' }" />
                                <Text id="actionWhyHere" class="cmWhyHere" text="{ path: 'tier', formatter: '.tierText' }" />
                                <ObjectStatus id="actionCanWait" visible="{= ${advice} === 'CAN_WAIT' }" state="Information" icon="sap-icon://ti/clock-pause"
                                    text="{ parts: ['i18n>canWait', 'cost'], formatter: 'formatMessage' }" />
                                <ObjectStatus id="actionNotThisWeek" visible="{= ${advice} === 'NO_BUDGET' }" text="{i18n>notThisWeek}" state="Warning" icon="sap-icon://ti/clock-pause" />
                            </VBox>
                        </HBox>
                    </CustomListItem>
                </List>

                <!-- ============ 2. Rowan: "for each part of the village, is it all right?" ============ -->
                <Title id="areasTitle" text="{i18n>areasTitle}" level="H2" class="sapUiMediumMarginTop sapUiSmallMarginBottom" />
                <List id="areasList" noDataText="{i18n>noData}"
                    items="{ path: '/Areas', sorter: { path: 'rank' }, templateShareable: false }">
                    <CustomListItem id="areaItem">
                        <VBox id="areaBox" class="cmItem">
                            <HBox id="areaHead" alignItems="Center" wrap="Wrap">
                                <Title id="areaName" text="{area}" level="H3" class="sapUiSmallMarginEnd" />
                                <ObjectStatus id="areaLevel"
                                    text="{ path: 'level', formatter: '.levelText' }"
                                    icon="{ path: 'level', formatter: '.levelIcon' }"
                                    state="{ path: 'level', formatter: '.levelState' }" class="sapUiSmallMarginEnd" />
                                <ObjectStatus id="areaTrend"
                                    text="{ path: 'trend', formatter: '.trendText' }"
                                    icon="{ path: 'trend', formatter: '.trendIcon' }"
                                    state="{ path: 'trend', formatter: '.trendState' }" />
                            </HBox>
                            <Text id="areaWater" text="{ path: 'waterCode', formatter: '.areaWater' }" />
                            <Text id="areaFood" text="{ parts: ['foodCode', 'foodItems'], formatter: '.areaFood' }" />
                        </VBox>
                    </CustomListItem>
                </List>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
